# ---- Laravel (api/) ----
/api/vendor/
/api/node_modules/
/api/public/build/
/api/public/hot
/api/public/storage
/api/storage/*.key
/api/storage/pail
/api/.env
/api/.env.backup
/api/.env.production
/api/.phpunit.result.cache
/api/.phpunit.cache/
/api/Homestead.json
/api/Homestead.yaml
/api/auth.json
/api/bootstrap/cache/*.php
/api/database/*.sqlite
/api/database/*.sqlite-journal

# ---- Frontend (web/) ----
/web/node_modules/
/web/dist/
/web/dev-dist/
/web/.vite/
/web/playwright-report/
/web/test-results/
/web/coverage/
/web/.env.local
/web/.env.*.local

# ---- Video (video/) ----
/video/node_modules/
/video/out/
/video/.remotion/

# ---- Generated content (large, regenerable) ----
/content/questions/*.generated.json

# ---- Tooling / OS ----
node_modules/
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-error.log*
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# ---- Secrets: never commit ----
*.pem
*.key
!deploy/**/*.example.key
secrets/

# web build artifacts
/web/node_modules/
/web/dist/

# playwright
/web/test-results/
/web/playwright-report/
/web/.playwright/

# ---- نسخ محلية للعرض، خارج المستودع عمداً ----
