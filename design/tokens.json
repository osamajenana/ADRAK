{
  "$schema": "./tokens.schema.md",
  "name": "ADRAK Design Tokens",
  "version": "1.0.0",
  "notes": "Source of truth for the design system. web/src/styles/tokens.css is generated from this file by tools/build-tokens.mjs — never hand-edit the CSS. Every foreground/background pair listed in `contrast_pairs` is verified against WCAG 2.2 AA by tools/check-contrast.mjs in CI.",

  "palette": {
    "teal": {
      "50": "#EFFCFA", "100": "#D3F6F1", "200": "#A9EDE5", "300": "#71DED4",
      "400": "#38C6BE", "500": "#1CA9A3", "600": "#128884", "650": "#0F7A76", "700": "#136C6A",
      "800": "#145656", "900": "#144747", "950": "#052C2D"
    },
    "amber": {
      "50": "#FFFBEB", "100": "#FEF3C7", "200": "#FDE68A", "300": "#FCD34D",
      "400": "#FBBF24", "500": "#F59E0B", "600": "#D97706", "700": "#B45309",
      "800": "#92400E", "900": "#78350F", "950": "#451A03"
    },
    "slate": {
      "50": "#F7F9FC", "100": "#EEF2F7", "200": "#DDE4EC", "300": "#C2CDDA",
      "350": "#A8B6C6", "400": "#94A3B8", "450": "#8494A8", "500": "#6B7C90",
      "550": "#5E7085", "600": "#556577", "700": "#3F4C5C",
      "800": "#2A3543", "900": "#18222E", "950": "#0A0F16"
    },
    "rose": {
      "400": "#FB7185", "500": "#F43F5E", "600": "#E11D48", "700": "#BE123C"
    }
  },

  "semantic": {
    "dark": {
      "_comment": "Dark is the DEFAULT theme. OLED battery saving on the low-end Androids most students share, and readable when the only light source at night is a phone screen.",
      "bg": "#0A0F16",
      "surface": "#121A24",
      "surface-raised": "#1B2634",
      "border": "#28374A",
      "border-strong": "#5E7085",
      "text": "#E9EFF6",
      "text-muted": "#A3B2C4",
      "text-subtle": "#7B8A9C",
      "primary": "#38C6BE",
      "primary-hover": "#71DED4",
      "primary-fg": "#052C2D",
      "focus": "#71DED4",
      "mastered": "#38C6BE",
      "mastered-fg": "#052C2D",
      "learning": "#FBBF24",
      "learning-fg": "#451A03",
      "weak": "#FCD34D",
      "locked": "#3F4C5C",
      "locked-fg": "#C2CDDA",
      "retry": "#FBBF24",
      "retry-surface": "#2A2113",
      "offline": "#A3B2C4",
      "offline-surface": "#1B2634",
      "danger": "#FB7185",
      "danger-fg": "#0A0F16"
    },
    "light": {
      "_comment": "Light theme is tuned for direct sunlight and cracked screens: higher contrast than a typical light UI, no low-contrast grey-on-white anywhere.",
      "bg": "#F7F9FC",
      "surface": "#FFFFFF",
      "surface-raised": "#FFFFFF",
      "border": "#DDE4EC",
      "border-strong": "#8494A8",
      "text": "#18222E",
      "text-muted": "#3F4C5C",
      "text-subtle": "#556577",
      "primary": "#0F7A76",
      "primary-hover": "#136C6A",
      "primary-fg": "#FFFFFF",
      "focus": "#0F7A76",
      "mastered": "#136C6A",
      "mastered-fg": "#FFFFFF",
      "learning": "#B45309",
      "learning-fg": "#FFFFFF",
      "weak": "#92400E",
      "locked": "#C2CDDA",
      "locked-fg": "#3F4C5C",
      "retry": "#B45309",
      "retry-surface": "#FFFBEB",
      "offline": "#3F4C5C",
      "offline-surface": "#EEF2F7",
      "danger": "#BE123C",
      "danger-fg": "#FFFFFF"
    }
  },

  "contrast_pairs": [
    ["text", "bg", 4.5],
    ["text", "surface", 4.5],
    ["text", "surface-raised", 4.5],
    ["text-muted", "bg", 4.5],
    ["text-muted", "surface", 4.5],
    ["text-subtle", "surface", 3.0],
    ["primary", "bg", 3.0],
    ["primary", "surface", 3.0],
    ["primary-fg", "primary", 4.5],
    ["focus", "bg", 3.0],
    ["mastered-fg", "mastered", 4.5],
    ["learning-fg", "learning", 4.5],
    ["locked-fg", "locked", 4.5],
    ["retry", "retry-surface", 4.5],
    ["offline", "offline-surface", 4.5],
    ["danger-fg", "danger", 4.5],
    ["border-strong", "surface", 3.0]
  ],

  "typography": {
    "family": {
      "sans": "'IBM Plex Sans Arabic', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, 'Cascadia Code', monospace"
    },
    "_family_note": "Self-hosted and subset — no Google Fonts CDN. The PWA must render identically with the network off, and an external font host is a dependency we cannot honour offline.",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "_note": "Student app uses `base-student` (18px) rather than 16px: 10-15 year olds, shared phones held at arm's length, and screens with cracks across them.",
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "base-student": "1.125rem",
      "lg": "1.25rem",
      "xl": "1.5rem",
      "2xl": "1.875rem",
      "3xl": "2.25rem",
      "4xl": "3rem"
    },
    "leading": { "tight": 1.3, "normal": 1.7, "relaxed": 1.9 },
    "_leading_note": "Arabic needs more line-height than Latin — diacritics and descenders collide at 1.5. Body text is 1.7."
  },

  "space": {
    "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem",
    "5": "1.25rem", "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem",
    "16": "4rem", "20": "5rem", "24": "6rem"
  },

  "radius": {
    "sm": "0.5rem", "md": "0.75rem", "lg": "1rem", "xl": "1.25rem", "pill": "999px"
  },

  "size": {
    "touch-min": "44px",
    "_touch_note": "WCAG 2.2 AA requires 24px. We use 44px: children, shared devices, and cracked digitisers where a mistap costs a wrong answer the student did not make.",
    "answer-option-min-height": "56px",
    "content-max-width": "42rem"
  },

  "motion": {
    "duration": { "fast": "150ms", "base": "250ms", "slow": "400ms", "pulse": "2000ms" },
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "_note": "Every duration collapses to 0ms under `prefers-reduced-motion` AND under the in-app battery-saver toggle. The pulse animation on the Skill Map recovery path is the first thing battery-saver turns off."
  },

  "elevation": {
    "_note": "Dark theme uses surface lightening rather than shadows — shadows are close to invisible on a dark background and cost paint time on weak GPUs.",
    "sm": "0 1px 2px rgb(0 0 0 / 0.06)",
    "md": "0 4px 12px rgb(0 0 0 / 0.08)",
    "lg": "0 12px 32px rgb(0 0 0 / 0.12)"
  },

  "performance_budget": {
    "_note": "Enforced in CI. These are the numbers that decide whether a student on 2G ever sees the app.",
    "student_bundle_gzip_kb": 200,
    "font_subset_kb": 60,
    "lcp_slow_3g_ms": 2500,
    "battery_per_30min_session_pct": 2
  }
}
